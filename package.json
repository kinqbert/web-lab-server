{
  "name": "web-lab-server",
  "version": "1.0.0",
  "main": "index.js",
  "scripts": {
    "start": "npm run start:all",
    "start:all": "concurrently \"npm run start:user\" \"npm run start:gateway\"",
    "start:user": "npm --prefix ./services/user-service run start",
    "start:gateway": "npm --prefix ./services/api-gateway run start",
    "dev": "npm run dev:all",
    "dev:all": "concurrently \"npm run dev:user\" \"npm run dev:gateway\"",
    "dev:user": "npm --prefix ./services/user-service run dev",
    "dev:gateway": "npm --prefix ./services/api-gateway run dev",
    "lint": "eslint --max-warnings=0"
  },
  "devDependencies": {
    "@typescript-eslint/eslint-plugin": "^8.26.1",
    "@typescript-eslint/parser": "^8.26.1",
    "concurrently": "^7.6.0",
    "eslint": "^9.22.0",
    "eslint-plugin-import": "^2.31.0",
    "typescript": "^5.8.2",
    "typescript-eslint": "^8.26.1"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "description": ""
}
