{
  "name": "web-lab-server",
  "version": "1.0.0",
  "scripts": {
    "dev": "npm run dev:all",
    "dev:all": "concurrently --kill-others-on-fail --prefix-colors red,cyan,green,yellow,magenta --names RABBIT,USER,GTWY,TRNS,GOAL \"npm run rabbit:start\" \"npm run dev:user\" \"npm run dev:gateway\" \"npm run dev:transaction\" \"npm run dev:goal\"",
    "dev:user": "npm --prefix ./services/user-service run dev",
    "dev:gateway": "npm --prefix ./services/api-gateway run dev",
    "dev:transaction": "npm --prefix ./services/transaction-service run dev",
    "dev:goal": "npm --prefix ./services/goal-service run dev",
    "rabbit:start": "docker compose -f rabbitmq/docker-compose.yml up -d",
    "rabbit:stop": "docker compose -f rabbitmq/docker-compose.yml down",
    "lint": "eslint \"services/**/*.ts\" --max-warnings=0",
    "test": "jest",
    "test:coverage": "jest --coverage"
  },
  "devDependencies": {
    "@types/jest": "^29.5.14",
    "@types/morgan": "^1.9.9",
    "@types/supertest": "^6.0.3",
    "@typescript-eslint/eslint-plugin": "^8.26.1",
    "@typescript-eslint/parser": "^8.26.1",
    "concurrently": "^8.0.0",
    "eslint": "^9.22.0",
    "eslint-plugin-import": "^2.31.0",
    "jest": "^29.7.0",
    "mongodb-memory-server": "^10.1.4",
    "supertest": "^7.1.0",
    "ts-jest": "^29.3.2",
    "typescript": "^5.8.2"
  },
  "dependencies": {
    "joi": "^17.13.3",
    "morgan": "^1.10.0"
  }
}
